# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores
# do SEU projeto Supabase do Cash App (não é o do COSMO — é um projeto novo).
# O .env nunca vai pro GitHub (está no .gitignore) — na Vercel, essas mesmas
# variáveis são coladas em Settings > Environment Variables.

# --- Front-end (prefixo VITE_, vai pro navegador) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Funções serverless (api/), só na Vercel, nunca no navegador ---

# api/resumo.js — resumo agregado que o COSMO (assistente principal) consulta
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESUMO_API_TOKEN=

# api/chat.js e api/extrair-arquivo.js — chat com o COSMO e leitura de
# arquivos/comprovantes dentro do próprio Correa Cash. SUPABASE_ANON_KEY
# aqui é a MESMA chave pública de VITE_SUPABASE_ANON_KEY (sem o prefixo
# VITE_, porque estas duas funções recebem o token da pessoa logada e usam
# RLS normalmente, nunca a service_role key).
SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=

# api/verificar-assinaturas.js — checagem diária das assinaturas em débito
# automático (chamada por um cron do cron-job.org). Usa a service_role key
# de cima (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY) + esta senha:
CRON_SECRET=
